{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": ".*get_ad_performance$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/capture_ad_performance.py\"",
            "timeout": 30,
            "statusMessage": "대용량 광고 성과 응답을 파일로 우회 중"
          }
        ]
      },
      {
        "matcher": ".*(get_ad_performance|get_target_progress_v2|list_promotions)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/save_responses.py\"",
            "timeout": 30,
            "statusMessage": "보고서용 응답 원본 저장 중"
          }
        ]
      }
    ]
  }
}
