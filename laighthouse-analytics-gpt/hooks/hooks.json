{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": ".*get_ad_performance$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/capture_ad_performance.py\"",
            "timeout": 30,
            "statusMessage": "대용량 광고 성과 응답을 파일로 우회 중"
          }
        ]
      },
      {
        "matcher": ".*get_ad_performance$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/ad_performance_domain.py\"",
            "timeout": 30,
            "statusMessage": "광고 성과 도메인 규칙 붙이는 중"
          }
        ]
      },
      {
        "matcher": ".*(get_ad_performance|get_external_context|get_media_mix_job)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/save_responses.py\"",
            "timeout": 30,
            "statusMessage": "응답 원본 저장 중"
          }
        ]
      }
    ]
  }
}
